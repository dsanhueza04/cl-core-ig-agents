# Copia este archivo a .env (no se versiona) solo si quieres cambiar el comportamiento por defecto.
# Sin configurar nada, el sistema usa respuestas simuladas: gratis y sin red.

# Backend de modelos: mock | local | anthropic
LLM_BACKEND=mock

# local: cualquier servidor compatible con la API de OpenAI (por ejemplo Ollama). Se asume gratuito.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# anthropic: solo si decides usar la API de Anthropic (créditos prepagados, de pago).
ANTHROPIC_API_KEY=

# Tope de gasto por corrida, en USD. Solo aplica a backends de pago.
MAX_COST_USD_PER_RUN=2.00
